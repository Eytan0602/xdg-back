<%@ page contentType="application/json" pageEncoding="UTF-8" %><%@ page import="java.sql.*, java.util.*, java.io.*" %><%@ include file="../includes/db.jsp" %><%@ include file="../includes/cors.jsp" %><%@ include file="../includes/json-request.jsp" %><% Map<String,String> jsonBody = parseJsonBody(request); String action = param(request, jsonBody, "action"); String juegoIdStr = param(request, jsonBody, "juego_id"); if (action == null || juegoIdStr == null) { response.setStatus(400); out.print("{\"error\":\"Faltan parametros\"}"); return; } int juegoId = Integer.parseInt(juegoIdStr); if (action.equals("add")) { Statement countSt = con.createStatement(); ResultSet countRs = countSt.executeQuery("SELECT count(*) FROM juegos WHERE en_carrusel = TRUE"); countRs.next(); if (countRs.getInt(1) >= 5) { response.setStatus(400); out.print("{\"error\":\"Limite maximo de 5 juegos en el carrusel alcanzado.\"}"); return; } PreparedStatement ps = con.prepareStatement("UPDATE juegos SET en_carrusel = TRUE WHERE id = ?"); ps.setInt(1, juegoId); ps.executeUpdate(); out.print("{\"success\":true}"); } else if (action.equals("remove")) { PreparedStatement ps = con.prepareStatement("UPDATE juegos SET en_carrusel = FALSE WHERE id = ?"); ps.setInt(1, juegoId); ps.executeUpdate(); out.print("{\"success\":true}"); } else { response.setStatus(400); out.print("{\"error\":\"Accion invalida\"}"); return; } %><%@ include file="../includes/db_close.jsp" %>
