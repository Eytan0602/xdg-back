<%@ page contentType="application/json" pageEncoding="UTF-8" %>
<%@ page import="java.sql.*, java.util.*" %>
<%@ include file="../includes/db.jsp" %>
<%@ include file="../includes/cors.jsp" %>
<% String __role = (String) session.getAttribute("user_role"); if (!"admin".equals(__role)) { response.setStatus(401); out.print("{\"error\":\"No autorizado\"}"); return; } %>
<% String sql = "SELECT j.*, d.porcentaje AS descuento_porcentaje FROM juegos j LEFT JOIN descuentos d ON j.id = d.juego_id AND d.fecha_inicio <= CURRENT_DATE AND d.fecha_fin >= CURRENT_DATE WHERE j.en_carrusel = TRUE ORDER BY j.updated_at DESC LIMIT 5;"; PreparedStatement ps = con.prepareStatement(sql); ResultSet rs = ps.executeQuery(); StringBuilder json = new StringBuilder("["); boolean first = true; while (rs.next()) { if (!first) json.append(","); first = false; json.append("{"); json.append("\"id\":").append(rs.getInt("id")).append(","); json.append("\"titulo\":\"").append(rs.getString("titulo").replace("\"", "\\\"")).append("\","); json.append("\"descripcion\":\"").append(rs.getString("descripcion").replace("\"", "\\\"").replace("\n", "\\n")).append("\","); json.append("\"imagen_url\":\"").append(rs.getString("imagen_url").replace("\"", "\\\"")).append("\","); json.append("\"video_url\":\"").append(rs.getString("video_url").replace("\"", "\\\"")).append("\","); json.append("\"precio\":").append(rs.getDouble("precio")); if (rs.getObject("descuento_porcentaje") != null) { json.append(",\"descuento_porcentaje\":").append(rs.getDouble("descuento_porcentaje")); } json.append("}"); } json.append("]"); out.print(json.toString()); %>
<%@ include file="../includes/db_close.jsp" %>
